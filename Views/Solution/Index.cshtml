@*DISCUSS POPUP SECTION BEGINS*@
<div class="modal fade" id="DiscussPopUp" tabindex="-1" role="dialog" aria-labelledby="DiscussPopUpLabel" aria-hidden="true">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="DiscussPopUpLabel">Modal title</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <form action="" method="post">
                    <div class="form-group">
                        <label class="font-weight-bold">Name</label>
                        <input type="text" name="Name" required="required" class="form-control contact-form-field" placeholder="Your Name" value="" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Email</label>
                        <input type="text" name="Name" required="required" class="form-control contact-form-field" placeholder="Your Email" value="" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Mobile No.</label>
                        <input type="text" name="Name" required="required" class="form-control contact-form-field" placeholder="Mobile Number" value="" />
                    </div>
                    <div class="form-group">
                        <label class="font-weight-bold">Message</label>
                        <textarea name="Message" required="required" class="form-control contact-form-textarea" placeholder="Your Message"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-primary">Save changes</button>
            </div>
        </div>
    </div>
</div>


