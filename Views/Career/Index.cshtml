<!-- Social media section begin -->
<div>
    @Html.Partial("_SocialAccount")
</div>

<!-- Social media section end -->
<!-- footer section start -->
<div>
    @Html.Partial("Partial")
</div>

<!-- footer section end -->

<div>
    @Html.Partial("JobApply_Popup")
</div>

<script>
    $("#junior_NET").hide();
    $(".cardActive").addClass("cardActive")

    $('#btnClick1').click(function () {
        $('#senior_NET').show();
        $('#junior_NET').hide();
        $(".cardActive").removeClass("cardActive");
        $(this).addClass("cardActive")
    });
    $('#btnClick2').click(function () {
        $('#junior_NET').show();
        $('#senior_NET').hide();
        $(".cardActive").removeClass("cardActive");
        $(this).addClass("cardActive")
    });
</script>
