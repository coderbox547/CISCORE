<!-- Initialize Swiper -->
<script>
    var swiper = new Swiper('.swiper-container', {
        slidesPerView: 3,
        spaceBetween: 30,
        pagination: {
            el: '.swiper-pagination',
            clickable: true,
        },
        // Responsive breakpoints
        breakpoints: {

            // when window width is >= 640px
            640: {
                slidesPerView: 2,
                spaceBetween: 40
            },
            1000: {
                slidesPerView: 3,
                spaceBetween: 40
            }
        }
    });
</script>