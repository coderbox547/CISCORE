            <div class="col-md-7 col-12">
                <div class="subscribe_wrapper text-center">
                    <h6>Subscribe us to get exculsive offers and latest updates.</h6>
                    <form action="Subscribe" method="post" class="subscribe_input">
                        <input type="email" id="emailValidate" onchange="validateEmail()" name="Subscribe" required="required" class="form-control contact-form-field shadow" placeholder="Your Email" value="" />
