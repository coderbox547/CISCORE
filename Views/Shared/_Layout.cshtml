<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <link rel="icon" type="image/x-icon" href="~/images/favicon.ico" />
    <title>Confianza IT Solutions Pvt Ltd</title>

    <!-- CSS -->
    <link rel="stylesheet" href="~/css/swiper-bundle.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.12.1/css/all.min.css">
    <link rel="stylesheet" href="~/css/aos.css">
    <link rel="stylesheet" href="~/css/bootstrap.css">
    <link rel="stylesheet" href="~/css/style.css">
    <link rel="stylesheet" href="~/css/responsive.css">

    <!-- Scripts -->
    <script src="~/js/jquery-3.3.1.min.js"></script>
    <script src="~/js/bootstrap.min.js"></script>
    <script src="~/js/swiper-bundle.min.js"></script>
    <script src="~/js/script.js"></script>
    <script src="https://kit.fontawesome.com/0f19d42a1c.js" crossorigin="anonymous"></script>
</head>

<body data-target=".header-nav">

    <!-- Navigation -->
    <header class="header-nav">
        <nav class="navbar navbar-expand-lg navbar-light fixed-top">
            <div class="container-fluid justify-content-lg-start px-md-3">
                <a class="navbar-brand col-lg-2 col-md-3 col-sm-4 col-6 mr-0 px-0"
                   asp-controller="Home" asp-action="Index">
                    <img src="~/images/logo_new.svg" alt="Confianza IT Solutions" title="Confianza IT Solutions Pvt Ltd" />
                </a>
                <button class="navbar-toggler" type="button" data-toggle="collapse"
                        data-target="#navbarNavDropdown" aria-controls="navbarNavDropdown"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <div id="menu_icon">
                        <span></span><span></span><span></span><span></span>
                    </div>
                </button>
                <div class="collapse navbar-collapse col-lg-8 col-12 justify-content-center" id="navbarNavDropdown">
                    <ul class="navbar-nav">
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Services"
                               asp-route-tag="service">Services</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Solution" asp-action="Index">Hire our team</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Portfolio" asp-action="Index">Portfolio</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Home" asp-action="Process"
                               asp-route-tag="process">Process</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Career" asp-action="Index">Careers</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Contact" asp-action="Index">Contact Us</a>
                        </li>
                    </ul>
                </div>
                <div class="col-lg-2 col-md-10 col-sm-8 col-12 banner_bttn d-none d-lg-block text-right px-lg-0">
                    <a href="tel:+91-7009705881">
                        <i class="fas fa-mobile-alt mr-3"></i>+91-872-707-0065
                    </a>
                </div>
            </div>
        </nav>
        <div class="clearfix"></div>
    </header>

    <div class="body-content">
        @RenderBody()

        <div>
            <div class="side_socialLinks d-none d-xl-block">
                <ul class="m-0 p-0">
                    <li><h6>Follow Us</h6></li>
                    <li>
                        <a href="#!" title="Facebook" target="_blank">
                            <i class="fab fa-facebook-f"></i>
                        </a>
                    </li>
                    <li>
                        <a href="https://www.instagram.com/confianzaitsolutions/" title="Instagram" target="_blank">
                            <i class="fab fa-instagram"></i>
                        </a>
                    </li>
                    <li>
                        <a href="https://www.linkedin.com/company/confianza-it-solutions" title="Linkedin" target="_blank">
                            <i class="fab fa-linkedin-in"></i>
                        </a>
                    </li>
                    <li>
                        <a href="#!" title="Twitter" target="_blank">
                            <i class="fab fa-twitter"></i>
                        </a>
                    </li>
                    <li>
                        <a href="#!" title="Behance" target="_blank">
                            <i class="fab fa-behance"></i>
                        </a>
                    </li>
                </ul>
            </div>
            <div class="clearfix"></div>
        </div>

        <footer>
            <div class="bottom-footer">
                <div class="container">
                    <div class="row">
                        <div class="left-text-footer col-md-12 text-center">
                            <p class="mb-0">Confianza IT Solutions &copy; @DateTime.Now.Year | All Rights Reserved</p>
                        </div>
                    </div>
                </div>
            </div>
        </footer>
    </div>

    <!-- Animation on scroll -->
    <script src="~/js/aos.js"></script>
    <script>
        AOS.init({ duration: 1000, disable: 'mobile' });
    </script>

    <!-- Mobile nav toggle -->
    <script>
        $(document).ready(function () {
            $('#menu_icon').click(function () {
                $(this).toggleClass('open');
            });
        });
    </script>

    <script src="~/js/particles.js"></script>
    <script src="~/js/app.js"></script>

    <!-- Scroll to top -->
    <div class="d-xl-block d-none">
        <a href="#" class="scrollup">
            <i class="fas fa-arrow-up"></i>
            <h6 class="mt-4">scroll to top</h6>
        </a>
    </div>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
