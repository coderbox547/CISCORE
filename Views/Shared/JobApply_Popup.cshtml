@model  CisCore.Models.Mail

<div class="modal fade" id="ApplyForJob" role="dialog" aria-labelledby="ApplyForJobLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-capitalize" id="ApplyForJobLabel">Drop your updated CV</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="row">
                    <div class="col-md-6 col-12">
                        <div>
                            <img src="~/images/career/apply.svg" draggable="false" alt="apply-img" />
                        </div>
                    </div>
                    <div class="col-md-6 col-12">
                        <form asp-controller="Career" asp-action="Index" method="post" enctype="multipart/form-data">
                            @Html.AntiForgeryToken()
                            <div class="form-group">
                                <label>Name</label>
                                <input type="text" name="Name" required="required" class="form-control contact-form-field" placeholder="Enter Full Name" value="" />
                            </div>

                            <div class="form-group">
                                <label>Email</label>
                                <input type="email" id="email_Id" name="Email" onchange="validateEmail()" required="required" class="form-control contact-form-field" placeholder="Your Email" value="" />
                                <p class="validationText mb-0" id="emailShow"></p>
                            </div>

                            <div class="form-group" id="validate">
                                <label>Mobile No.</label>
                                <input type="text" id="mobile_No" onchange="validateMobileNumber()" name="Phone_No" maxlength="10" required="required" class="form-control contact-form-field" placeholder="Your Contact Number" value="" />
                                @Html.ValidationMessageFor(model => model.Phone_No)
                                <p class="validationText mb-0" id="mobileNoShow"></p>
                            </div>

                            <div class="form-group">
                                <label>Position Applied For</label>
                                @*<select class="form-control">
                                        <option selected>Choose an option</option>
                                        <option value="">Senior .Net Developer</option>
                                        <option value="">Wordpress Developer</option>
                                    </select>*@
                                @Html.DropDownListFor(model => model.Position, (SelectList)ViewBag.Positions, "Position Applied For", new { @class = "form-control contact-form-field", required = "required" })
                            </div>

                            <div class="form-group">
                                <label>Upload Latest Resume</label>
                                @*<input type="file" class="form-control-file" required accept=".pdf, .doc, .docx">
        <small class="form-text text-muted mt-3">Use only pdf and doc file.</small>*@
                                @Html.TextBox("file", "", new { type = "file", required = "required" , accept = ".pdf, .doc, .docx" }) <br />
                            </div>

                            <div class="border-top mt-4 pt-4 text-right">
                                <button type="submit" class="apply_btn ml-2" value="Send Message">Apply</button>
                            </div>
                        </form>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<script>
    function validateMobileNumber() {
        var mobileNumber = document.getElementById("mobile_No").value;
        var mobileNumberPattern = /^[0-9]{10}$/;
        var messageShowNumber = document.getElementById("mobileNoShow");

        if (!mobileNumberPattern.test(mobileNumber)) {
            messageShowNumber.textContent = "Please Enter Correct Mobile Number";
            messageShowNumber.style.display = "block";
            return false;
        }
        else {
            messageShowNumber.style.display = "none";
        }
    }
    function validateEmail() {
        var email = document.getElementById("email_Id").value;
        var emailRegexPattern = /^([A-Za-z]|[0-9])+$/;
        var messageShowEmail = document.getElementById("emailShow");

        if (emailRegexPattern.test(email)) {
            messageShowEmail.textContent = "Please enter a valid email address";
            messageShowEmail.style.display = "block";
            return false;
        }
        else {
            messageShowEmail.style.display = "none";
        }
    }
</script>