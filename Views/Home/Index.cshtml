    <script>
        function validateEmail() {
            var email = document.getElementById("email_sd").value;
            var emailRegexPattern = /^([A-Za-z]|[0-9])+$/;
            var messageShowEmail = document.getElementById("emaiShowName");

            if (emailRegexPattern.test(email)) {
                messageShowEmail.textContent = "Please enter a valid email address";
                messageShowEmail.style.display = "block";
                return false;
            }
            else {
                messageShowEmail.style.display = "none";
            }
        }
    </script>

    <!-- SUBSCRIBE POPUP APPEARS ON LOAD OF HOME PAGE BEGINS -->
    <script>
        window.addEventListener("load", function () {
            this.setTimeout(
                function open(event) {
                    document.querySelector("#NewsLetterModal").classList.add("show");
                },
                3500

            )
        });

        document.querySelector(".CloseModal").addEventListener("click", function () {
            document.querySelector("#NewsLetterModal").classList.remove("show");
        });

        document.querySelector('body').addEventListener('click', function () {
            document.querySelector('#NewsLetterModal').classList.remove('show');
        });
        document.querySelector('#NewsLetterModal').addEventListener('click', function (e) {
            e.stopPropagation();
        });

    </script>

    <!-- animation on scroll js begin -->
    <script src="~/js/aos.js"></script>
    <script>
        AOS.init({
            duration: 1000,
            disable: 'mobile'
        });
    </script>

    <script>
        $(document).ready(function () {
            $('.carousel').carousel();

        });
    </script>
    <script>
        var isInViewport = function (elem) {
            var bounding = elem.getBoundingClientRect();
            return (
                bounding.top <= 250
            );
        };
        var loaded = false;
        $(window).on('scroll', function () {
            var h1 = document.querySelector('#ProcessSection');
            if (isInViewport(h1) && !loaded) {
                this.loaded = true;
                var html = $('.refresh-section').html();
                $('#process-section').html(html);
                $('#SVGProcess').css('display', 'block');

                var s = Snap('#animated2');

                var first = s.select('#p');
                var second = s.select('#y');
                var third = s.select('#bl');
                var forth = s.select('#g');
                var fifth = s.select('#ro');
                var sixth = s.select('#r');
                var seventh = s.select('#sa');


                Snap.animate(0, 107, function (value) {
                    first.attr({ 'stroke-dasharray': value + '0,107' });
                    $('#y').hide();
                    $('#bl').hide();
                    $('#r').hide();
                    $('#g').hide();
                    $('#ro').hide();
                    $('#sa').hide();

                    if (value == 107) {

                        Snap.animate(0, 108, function (value) {
                            second.attr({ 'stroke-dasharray': value + ',108' });
                            $('#y').show();
                            if (value == 108) {

                                Snap.animate(0, 109, function (value) {
                                    third.attr({ 'stroke-dasharray': value + ',109' });
                                    $('#bl').show();

                                    if (value == 109) {

                                        Snap.animate(0, 110, function (value) {
                                            forth.attr({ 'stroke-dasharray': value + ',110' });
                                            $('#g').show();


                                            if (value == 110) {

                                                Snap.animate(0, 111, function (value) {
                                                    fifth.attr({ 'stroke-dasharray': value + ',111' });
                                                    $('#ro').show();
                                                    if (value == 111) {

                                                        Snap.animate(0, 112, function (value) {
                                                            sixth.attr({ 'stroke-dasharray': value + ',112' });
                                                            $('#r').show();
                                                            if (value == 112) {

                                                                Snap.animate(0, 113, function (value) {
                                                                    seventh.attr({ 'stroke-dasharray': value + ',113' });
                                                                    $('#sa').show();


                                                                }, 1400);
                                                            }


                                                        }, 1400);
                                                    }


                                                }, 1400);
                                            }

                                        }, 1400);
                                    }

                                }, 1400);
                            }

                        }, 1400);
                    }

                }, 1400);
            }
        })


    </script>

