                            <h4>At Confianza IT Solutions, we are dedicated to delivering extensive mobile and web development services tailored for both individual and corporate clients. Additionally, we offer access to dedicated remote resources, enabling your business to thrive anywhere in the world.</h4>
                            <div class="banner-bttn-mobile text-sm-center text-md-left">
                                <div class="d-none d-xl-block d-lg-block d-md-block d-sm-block">
                                    <span class="banner_bttn mr-4"> @Html.ActionLink("Get a Quote", "Index", "Get_a_quote")</span>
                                    <span class="banner_bttn"> @Html.ActionLink("Portfolio", "Index", "Portfolio")</span>
                                </div>
                                <div class="clearfix"></div>
                            </div>
                        </div>
                    </div>
                    <div class="col-md-6 col-sm-12" data-aos="fade-left" data-aos-once="true">
                        <div class="bg_laptop">
                            <img src="~/images/banner/banner1.svg" alt="laptop" />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- banner buttons for mobile section begin -->
    <div class="banner-btn-mobile d-block d-xl-none d-lg-none d-md-none d-sm-none">
