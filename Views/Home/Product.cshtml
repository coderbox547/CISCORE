            <div class="row">
                <div class="col-md-12 slider-txt mb-4">
                    <h3>FEATURES</h3>
                </div>
            </div>
            <div class="row" @*data-aos="zoom-in"*@>
                <div class="col-lg-5 col-md-5 col-sm-6">
                    <div class="man-sec">
                        <img src="~/images/prod-banner.png">
                    </div>
                </div>
                <div class="col-lg-7 col-md-7 col-sm-6">
                    <div class="row">
                        <div class="col-md-4 col-sm-6">
                            <div class="card text-center my-3">
                                <div class="card-body">
                                    <div class="sub-row mb-4">
                                        <i class="fas fa-chalkboard"></i>
                                    </div>
                                    <strong>HIGH RESOLUTION</strong>
                                    <p class="card-text"></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <div class="card text-center my-3">
                                <div class="card-body">
                                    <div class="sub-row mb-4">
                                        <i class="far fa-eye"></i>
                                    </div>
                                    <strong>RETINA READY</strong>
                                    <p class="card-text"></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <div class="card text-center my-3">
                                <div class="card-body">
                                    <div class="sub-row mb-4">
                                        <i class="fas fa-pen-nib"></i>
                                    </div>
                                    <strong>CREATIVE DESIGN</strong>
                                    <p class="card-text"></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <div class="card text-center my-3">
                                <div class="card-body">
                                    <div class="sub-row mb-4">
                                        <i class="fas fa-laptop-code"></i>
                                    </div>
                                    <strong>CLEAN CODES</strong>
                                    <p class="card-text"></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <div class="card text-center my-3">
                                <div class="card-body">
                                    <div class="sub-row mb-4">
                                        <i class="fas fa-bullhorn"></i>
                                    </div>
                                    <strong>UNLIMITED FEATURES</strong>
                                    <p class="card-text"></p>
                                </div>
                            </div>
                        </div>
                        <div class="col-md-4 col-sm-6">
                            <div class="card text-center my-3">
                                <div class="card-body">
                                    <div class="sub-row mb-4">
                                        <i class="fab fa-simplybuilt"></i>
                                    </div>
                                    <strong>EASY TO USE</strong>
                                    <p class="card-text"></p>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
