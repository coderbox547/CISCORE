                    </div>
                    <div class="col-md-12 mt-2 mb-3">
                        <div class="carousel slide" id="carousel-7503">
                            <ol class="carousel-indicators">
                                <li data-slide-to="0" data-target="#carousel-7503" class="active">
                                </li>
                                <li data-slide-to="1" data-target="#carousel-7503">
                                </li>
                                <li data-slide-to="2" data-target="#carousel-7503">
                                </li>
                                <li data-slide-to="3" data-target="#carousel-7503">
                                </li>

                            </ol>
                            <div class="carousel-inner">
                                <div class="carousel-item active">
                                    <img class="d-block w-100" alt="Carousel Bootstrap First" src="~/images/four-prod.PNG">

                                </div>
                                <div class="carousel-item">
                                    <img class="d-block w-100" alt="Carousel Bootstrap Second" src="~/images/two-prod.PNG">

                                </div>
                                <div class="carousel-item">
                                    <img class="d-block w-100" alt="Carousel Bootstrap Third" src="~/images/three-prod.PNG">

                                </div>
                                <div class="carousel-item">
